<!-- ===== Fixed UI ===== -->
<div class="brand" id="brandTL"><img src="data:image/png;base64," alt="Contecto"></div>
<div class="brand" id="brandTR"><img src="data:image/png;base64," alt="HAN"></div>

<div id="bottombar">
  <div id="pdove"></div>
  <div id="counter"></div>
</div>
<div id="progress"></div>

<div class="nav">
  <button id="prevBtn" aria-label="Vorige">‹</button>
  <button id="nextBtn" aria-label="Volgende">›</button>
</div>
<div class="notes-hint">Spreeknotities: <b>N</b></div>

<div id="notes">
  <span class="ncount" id="ncount"></span>
  <h4>Spreeknotities</h4>
  <div class="ntext" id="ntext"></div>
</div>

<div id="help">
  <div class="helpcard">
    <h3>Navigatie</h3>
    <table>
      <tr><td><kbd>→</kbd> <kbd>spatie</kbd></td><td>Volgende stap / slide</td></tr>
      <tr><td><kbd>←</kbd></td><td>Vorige stap / slide</td></tr>
      <tr><td><kbd>Home</kbd> <kbd>End</kbd></td><td>Eerste / laatste slide</td></tr>
      <tr><td><kbd>N</kbd></td><td>Spreeknotities tonen/verbergen</td></tr>
      <tr><td><kbd>F</kbd></td><td>Volledig scherm</td></tr>
      <tr><td><kbd>?</kbd></td><td>Deze hulp</td></tr>
      <tr><td>klik</td><td>Op balken, kernproblemen, keuzes en fasen voor details</td></tr>
    </table>
  </div>
</div>

<script>
(function(){
  const slides=[...document.querySelectorAll('.slide')];
  const total=slides.length;
  let cur=0;

  const phaseOrder={P:0,D:1,O:2,V:3};
  const pdoveEl=document.getElementById('pdove');
  const counter=document.getElementById('counter');
  const progress=document.getElementById('progress');
  const notesPanel=document.getElementById('notes');
  const ntext=document.getElementById('ntext');
  const ncount=document.getElementById('ncount');
  const help=document.getElementById('help');

  // Build PDOVE stepper
  const steps=[['P','Probleem'],['D','Diagnose'],['O','Ontwerp'],['V','Verandering'],['E','Evaluatie']];
  pdoveEl.innerHTML=steps.map((s,i)=>{
    const sep=i<steps.length-1?'<span class="sep"></span>':'';
    return `<div class="step" data-letter="${s[0]}"><span class="dot">${s[0]}</span><span class="lbl">${s[1]}</span></div>${sep}`;
  }).join('');
  const stepEls=[...pdoveEl.querySelectorAll('.step')];

  function fragments(slide){return [...slide.querySelectorAll('.fragment')];}

  function updateChrome(){
    const slide=slides[cur];
    const phase=slide.dataset.phase;
    const cover=slide.classList.contains('cover-slide');
    document.body.classList.toggle('cover',cover);

    // PDOVE
    if(phase&&phase!=='done'){
      pdoveEl.style.visibility='visible';
      const co=phaseOrder[phase];
      stepEls.forEach(el=>{
        const L=el.dataset.letter;
        el.className='step';
        if(L==='E'){el.classList.add('out');return;}
        const o=phaseOrder[L];
        if(o<co)el.classList.add('done');
        else if(o===co)el.classList.add('active');
      });
    } else {
      pdoveEl.style.visibility='hidden';
    }

    counter.textContent=(cur+1)+' / '+total;
    progress.style.width=(cur/(total-1)*100)+'%';

    // notes
    const n=slide.querySelector('.notes');
    ntext.innerHTML=n?n.innerHTML:'';
    ncount.textContent=(cur+1)+' / '+total;
  }

  function show(idx,fromBack){
    idx=Math.max(0,Math.min(total-1,idx));
    slides[cur].classList.remove('active');
    cur=idx;
    const slide=slides[cur];
    slide.classList.add('active');
    const frs=fragments(slide);
    // entering forward: hide all fragments; entering backward: show all
    frs.forEach(f=>f.classList.toggle('vis',!!fromBack));
    updateChrome();
  }

  function next(){
    const slide=slides[cur];
    const frs=fragments(slide);
    const hidden=frs.find(f=>!f.classList.contains('vis'));
    if(hidden){hidden.classList.add('vis');return;}
    if(cur<total-1)show(cur+1,false);
  }
  function prev(){
    const slide=slides[cur];
    const frs=fragments(slide);
    const visible=frs.filter(f=>f.classList.contains('vis'));
    if(visible.length){visible[visible.length-1].classList.remove('vis');return;}
    if(cur>0)show(cur-1,true);
  }

  // Keyboard
  document.addEventListener('keydown',e=>{
    if(e.key==='ArrowRight'||e.key===' '||e.key==='PageDown'){e.preventDefault();next();}
    else if(e.key==='ArrowLeft'||e.key==='PageUp'){e.preventDefault();prev();}
    else if(e.key==='Home'){e.preventDefault();show(0,true);}
    else if(e.key==='End'){e.preventDefault();show(total-1,true);}
    else if(e.key==='n'||e.key==='N'){notesPanel.classList.toggle('open');}
    else if(e.key==='f'||e.key==='F'){if(!document.fullscreenElement)document.documentElement.requestFullscreen();else document.exitFullscreen();}
    else if(e.key==='?'||e.key==='/'){help.classList.toggle('open');}
    else if(e.key==='Escape'){help.classList.remove('open');notesPanel.classList.remove('open');}
  });

  document.getElementById('nextBtn').addEventListener('click',next);
  document.getElementById('prevBtn').addEventListener('click',prev);
  help.addEventListener('click',()=>help.classList.remove('open'));

  // Interactive: bars
  document.querySelectorAll('[data-bar]').forEach(b=>{
    b.addEventListener('click',()=>b.classList.toggle('open'));
  });

  // Interactive: probleemkluwen
  const kluwenTexts={
    '1':'KP 1 — Er wordt gepland op bewerkingsgroepniveau in plaats van op werkstationniveau, waardoor capaciteitsknelpunten onzichtbaar blijven.',
    '2':'KP 2 — De beschikbare capaciteit in Ridder iQ klopt niet: er wordt tegen oneindige capaciteit gepland, zonder verzuim, stilstand of flexibele inzet.',
    '3':'KP 3 — Afroeporders worden foutief verwerkt: alle uren op één vroege datum, wat schijncapaciteit oplevert (33,7% van de uren).',
    '4':'KP 4 — Er is geen visuele prioriteit op de werkvloer; prioriteiten zijn mondeling en persoonsafhankelijk (Schedule Adherence 29,53%).'
  };
  const kluwenDetail=document.getElementById('kluwenDetail');
  document.querySelectorAll('.kpnode').forEach(node=>{
    node.addEventListener('click',()=>{
      document.querySelectorAll('.kpnode').forEach(n=>n.classList.remove('sel'));
      node.classList.add('sel');
      if(kluwenDetail)kluwenDetail.textContent=kluwenTexts[node.dataset.kp];
    });
  });

  // Interactive: expandable choices
  document.querySelectorAll('[data-exp]').forEach(c=>{
    c.addEventListener('click',()=>c.classList.toggle('open'));
  });

  // Interactive: roadmap phases
  document.querySelectorAll('.phase').forEach(p=>{
    p.addEventListener('click',()=>p.classList.toggle('open'));
  });

  show(0,true);
})();
</script>
</body>
</html>
