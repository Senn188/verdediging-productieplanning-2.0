<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Verdediging Productieplanning 2.0 — Senn Lauwers</title>
<style>
  :root{
    --teal:#279989;
    --teal-dark:#1d7468;
    --teal-darker:#155349;
    --teal-soft:#e8f4f2;
    --teal-line:#bfe0da;
    --ink:#15302c;
    --muted:#5c6f6b;
    --bg:#ffffff;
    --magenta:#e6007e;
    --bad:#d64545;
    --good:#2e9e5b;
    --amber:#e0a200;
    --shadow:0 10px 30px rgba(21,83,73,.12);
    --radius:16px;
    --font:'Segoe UI',Roboto,-apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif;
  }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{font-family:var(--font);color:var(--ink);background:#0d2420;overflow:hidden;-webkit-font-smoothing:antialiased}

  #deck{position:fixed;inset:0;background:var(--bg);overflow:hidden}

  /* ---------- Slides ---------- */
  .slide{position:absolute;inset:0;display:none;flex-direction:column;justify-content:center;
    padding:clamp(28px,5vw,90px) clamp(34px,6vw,110px) clamp(70px,8vh,96px);
    animation:slideIn .5s ease both}
  .slide.active{display:flex}
  .slide.dense{justify-content:flex-start;padding-top:clamp(48px,6.5vh,78px)}
  .slide.dense .accentbar{margin-bottom:clamp(10px,1.8vh,18px)}
  .slide.dense .sub{margin-bottom:clamp(8px,1.4vh,16px)}
  @keyframes slideIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

  h1,h2,h3{margin:0;line-height:1.1}
  .eyebrow{font-size:clamp(.7rem,1vw,.85rem);font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--teal);margin-bottom:.5em}
  .slide h2{font-size:clamp(1.6rem,3.4vw,2.7rem);font-weight:800;letter-spacing:-.01em;margin-bottom:.15em}
  .slide .sub{color:var(--muted);font-size:clamp(.95rem,1.5vw,1.2rem);margin-bottom:clamp(14px,2.5vh,30px);max-width:60ch}
  p{line-height:1.45}

  .accentbar{width:64px;height:5px;border-radius:3px;background:var(--teal);margin:0 0 clamp(14px,2.4vh,26px)}

  /* ---------- Fragments ---------- */
  .fragment{opacity:0;transform:translateY(12px);transition:opacity .45s ease,transform .45s ease}
  .fragment.vis{opacity:1;transform:none}

  /* ---------- Brand corners ---------- */
  .brand{position:fixed;top:26px;z-index:30;background:#fff;border-radius:10px;padding:7px 12px;
    box-shadow:0 2px 10px rgba(21,83,73,.10);display:flex;align-items:center;transition:opacity .4s}
  #brandTL{left:30px}#brandTR{right:30px}
  .brand img{display:block;height:30px;width:auto}
  body.cover .brand{opacity:0;pointer-events:none}

  /* ---------- Bottom bar ---------- */
  #bottombar{position:fixed;left:0;right:0;bottom:0;height:54px;z-index:25;
    display:flex;align-items:center;justify-content:space-between;
    padding:0 clamp(20px,4vw,46px);transition:opacity .4s}
  body.cover #bottombar{opacity:0;pointer-events:none}
  #progress{position:fixed;left:0;bottom:0;height:4px;background:var(--teal);width:0;z-index:26;transition:width .45s ease}

  /* PDOVE stepper */
  #pdove{display:flex;gap:7px;align-items:center}
  .step{display:flex;align-items:center;gap:7px;font-size:.72rem;font-weight:700}
  .step .dot{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;
    background:#eef2f1;color:#9bada9;border:2px solid #e2e8e6;font-weight:800;font-size:.78rem;transition:.3s}
  .step .lbl{color:#9bada9;letter-spacing:.04em;transition:.3s;display:none}
  .step.active .lbl{display:inline}
  .step.done .dot{background:var(--teal-soft);color:var(--teal);border-color:var(--teal-line)}
  .step.active .dot{background:var(--teal);color:#fff;border-color:var(--teal);transform:scale(1.08)}
  .step.active .lbl{color:var(--teal)}
  .step.out .dot{background:repeating-linear-gradient(45deg,#f4f6f5,#f4f6f5 4px,#eceeed 4px,#eceeed 8px);
    color:#c2cdcb;border-style:dashed}
  .step.out .lbl{color:#c2cdcb;display:inline;text-decoration:line-through}
  .step .sep{width:14px;height:2px;background:#e2e8e6;border-radius:2px}

  #counter{font-size:.82rem;font-weight:700;color:var(--muted);letter-spacing:.04em}

  /* ---------- Cover (title) slide ---------- */
  .cover-slide{background:radial-gradient(120% 120% at 80% -10%,var(--teal) 0%,var(--teal-dark) 45%,var(--teal-darker) 100%);
    color:#fff;justify-content:center;align-items:flex-start}
  .cover-slide h1{font-size:clamp(2.4rem,6vw,5rem);font-weight:800;letter-spacing:-.02em}
  .cover-slide .lead{font-size:clamp(1.05rem,2vw,1.5rem);opacity:.92;margin:.6em 0 0;max-width:30ch}
  .cover-logos{position:absolute;top:clamp(28px,5vh,52px);left:clamp(34px,6vw,110px);right:clamp(34px,6vw,110px);
    display:flex;justify-content:space-between;align-items:center}
  .cover-logos .chip{background:#fff;border-radius:12px;padding:12px 16px;box-shadow:var(--shadow)}
  .cover-logos .chip img{display:block;height:clamp(34px,5vh,46px);width:auto}
  .cover-meta{margin-top:clamp(26px,5vh,46px);display:flex;flex-wrap:wrap;gap:10px 26px;font-size:clamp(.85rem,1.4vw,1.05rem)}
  .cover-meta b{font-weight:700}
  .cover-meta .it{display:flex;flex-direction:column;gap:2px;opacity:.95}
  .cover-meta .it span:first-child{font-size:.72em;text-transform:uppercase;letter-spacing:.12em;opacity:.7}
  .cover-hint{position:absolute;bottom:clamp(22px,5vh,40px);left:clamp(34px,6vw,110px);font-size:.85rem;opacity:.8}
  .cover-hint kbd{background:rgba(0,0,0,.24);border:1px solid rgba(255,255,255,.45);border-radius:6px;color:#fff;
    padding:2px 8px;font-family:inherit;font-size:.85em;font-weight:700;margin:0 2px}
  .pill{display:inline-block;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.3);
    border-radius:999px;padding:5px 14px;font-size:.8rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}

  /* ---------- Generic layout helpers ---------- */
  .cols{display:flex;gap:clamp(18px,2.6vw,40px);align-items:stretch}
  .col{flex:1;min-width:0}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:clamp(14px,2vw,26px)}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(14px,1.8vw,24px)}

  ul.clean{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:clamp(10px,1.6vh,18px)}
  ul.clean li{position:relative;padding-left:32px;font-size:clamp(.95rem,1.45vw,1.18rem);line-height:1.4}
  ul.clean li::before{content:"";position:absolute;left:0;top:.45em;width:13px;height:13px;border-radius:4px;
    background:var(--teal);transform:rotate(45deg)}
  ul.clean li b{color:var(--teal-dark)}

  .card{background:#fff;border:1px solid #e6efed;border-radius:var(--radius);padding:clamp(14px,1.8vw,24px);
    box-shadow:var(--shadow)}
  .card h3{font-size:clamp(1rem,1.5vw,1.25rem);font-weight:800;margin-bottom:.4em}
  .tag{display:inline-block;font-size:.68rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
    padding:4px 10px;border-radius:999px;margin-bottom:10px}
  .tag.diag{background:#fdeaea;color:var(--bad)}
  .tag.des{background:#e6f6ec;color:var(--good)}
  .tag.teal{background:var(--teal-soft);color:var(--teal-dark)}

  .kpi-row{display:flex;gap:clamp(14px,2vw,28px);flex-wrap:wrap}
  .kpi{background:var(--teal-soft);border:1px solid var(--teal-line);border-radius:14px;
    padding:clamp(12px,1.6vw,20px) clamp(16px,2vw,26px);min-width:150px;flex:1}
  .kpi .num{font-size:clamp(1.8rem,3.6vw,3rem);font-weight:800;color:var(--teal-dark);line-height:1}
  .kpi .num.bad{color:var(--bad)}
  .kpi .lab{font-size:clamp(.78rem,1.1vw,.95rem);color:var(--muted);margin-top:6px}
  .src{font-size:clamp(.72rem,1vw,.85rem);color:#8aa09b;font-style:italic;margin-top:14px}

  /* ---------- Bar chart (slide 3) ---------- */
  .bars{display:flex;flex-direction:column;gap:clamp(12px,2vh,22px);margin-top:6px}
  .barrow{cursor:pointer}
  .barrow .top{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px}
  .barrow .name{font-weight:700;font-size:clamp(.9rem,1.3vw,1.1rem)}
  .barrow .val{font-weight:800;font-size:clamp(1rem,1.5vw,1.3rem)}
  .track{position:relative;height:clamp(20px,3vh,30px);background:#eef2f1;border-radius:999px;overflow:hidden}
  .barfill{position:absolute;left:0;top:0;bottom:0;width:0;border-radius:999px;transition:width 1.1s cubic-bezier(.16,1,.3,1)}
  .barfill.bad{background:linear-gradient(90deg,#e76b6b,var(--bad))}
  .barfill.warn{background:linear-gradient(90deg,#f0b54a,var(--amber))}
  .slide.active .barfill{width:var(--w)}
  .goalline{position:absolute;top:-4px;bottom:-4px;width:2px;background:var(--teal-dark);left:10%}
  .goalline::after{content:"doel ≤10%";position:absolute;top:-20px;left:6px;font-size:.7rem;color:var(--teal-dark);font-weight:700;white-space:nowrap}
  .goalline.sa{left:85%}
  .goalline.sa::after{content:"doel ≥85%";left:-72px}
  .bardetail{max-height:0;overflow:hidden;transition:max-height .4s ease;color:var(--muted);font-size:.88rem}
  .barrow.open .bardetail{max-height:60px;margin-top:6px}

  /* ---------- Probleemkluwen (slide 6) ---------- */
  .kluwen{display:flex;gap:clamp(16px,2.4vw,38px);align-items:center}
  .kluwen .center{flex:0 0 auto;width:clamp(150px,17vw,230px);text-align:center;
    background:var(--ink);color:#fff;border-radius:18px;padding:clamp(14px,2vw,24px);box-shadow:var(--shadow)}
  .kluwen .center .big{font-size:clamp(1.6rem,3vw,2.4rem);font-weight:800;color:#fff}
  .kluwen .center small{display:block;opacity:.8;font-size:.8rem;margin-top:6px}
  .kpgrid{flex:1;display:grid;grid-template-columns:1fr 1fr;gap:clamp(10px,1.4vw,18px)}
  .kpnode{background:#fff;border:2px solid #e6efed;border-left:6px solid var(--teal);border-radius:12px;
    padding:clamp(10px,1.4vw,18px);cursor:pointer;transition:.25s}
  .kpnode:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
  .kpnode.sel{border-color:var(--teal);background:var(--teal-soft);box-shadow:var(--shadow)}
  .kpnode .h{font-weight:800;font-size:clamp(.92rem,1.3vw,1.1rem);color:var(--teal-dark)}
  .kpnode .num{font-size:.72rem;font-weight:800;color:var(--teal);letter-spacing:.08em}
  #kluwenDetail{margin-top:clamp(14px,2vh,22px);background:var(--teal-soft);border:1px solid var(--teal-line);
    border-radius:12px;padding:14px 18px;font-size:clamp(.9rem,1.3vw,1.1rem);min-height:54px;
    display:flex;align-items:center;color:var(--teal-darker)}

  /* ---------- KP slides: diagnose -> ontwerp ---------- */
  .flow{display:flex;align-items:center;gap:clamp(10px,1.4vw,20px)}
  .flow .arrow{flex:0 0 auto;font-size:clamp(1.4rem,2.4vw,2rem);color:var(--teal);font-weight:800}
  .panel{flex:1;background:#fff;border:1px solid #e6efed;border-radius:var(--radius);
    padding:clamp(14px,1.8vw,22px);box-shadow:var(--shadow);align-self:stretch}
  .panel.now{border-top:4px solid var(--bad)}
  .panel.next{border-top:4px solid var(--good)}
  .panel ul{margin:.2em 0 0;padding-left:1.1em}
  .panel li{margin:.4em 0;font-size:clamp(.86rem,1.25vw,1.05rem);line-height:1.35}
  .choices{display:flex;flex-direction:column;gap:8px;margin-top:4px}
  .choice{background:var(--teal-soft);border:1px solid var(--teal-line);border-radius:10px;padding:10px 12px;cursor:pointer;transition:.2s}
  .choice:hover{background:#dcefeb}
  .choice .ct{font-weight:700;font-size:clamp(.85rem,1.2vw,1.02rem);display:flex;justify-content:space-between;gap:10px;align-items:center}
  .choice .score{font-size:.72rem;font-weight:800;color:#fff;background:var(--teal);border-radius:999px;padding:2px 9px;white-space:nowrap}
  .choice .cd{max-height:0;overflow:hidden;transition:max-height .35s ease;font-size:.85rem;color:var(--muted);line-height:1.35}
  .choice.open .cd{max-height:160px;margin-top:7px}
  .theory{margin-top:12px;font-size:.82rem;color:var(--muted)}
  .theory b{color:var(--teal-dark)}

  /* ---------- Synthese (slide 11) ---------- */
  .syn{display:flex;align-items:stretch;gap:10px;flex-wrap:nowrap}
  .synblock{flex:1;border-radius:14px;padding:clamp(12px,1.5vw,20px);color:#fff;position:relative;min-width:0}
  .synblock .kp{font-size:.72rem;font-weight:800;letter-spacing:.1em;opacity:.9}
  .synblock .t{font-weight:800;font-size:clamp(.9rem,1.25vw,1.1rem);margin:4px 0 6px}
  .synblock .d{font-size:clamp(.76rem,1.05vw,.92rem);opacity:.95;line-height:1.3}
  .synblock.b2{background:var(--teal-darker)}
  .synblock.b1{background:var(--teal-dark)}
  .synblock.b3{background:var(--teal)}
  .synblock.b4{background:#3aa99a}
  .synarrow{display:flex;align-items:center;color:var(--teal);font-weight:800;font-size:1.4rem}
  .synfoot{margin-top:clamp(14px,2.2vh,24px);display:flex;gap:14px;flex-wrap:wrap}
  .badge{border-radius:10px;padding:10px 16px;font-size:clamp(.82rem,1.2vw,1rem);font-weight:600}
  .badge.wmape{background:#fdeaea;color:var(--bad)}
  .badge.sa{background:#e6f6ec;color:var(--good)}

  /* ---------- Knoster / cultuur (slide 12) ---------- */
  .knoster{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(10px,1.4vw,18px);margin-top:6px}
  .kn{background:#fff;border:1px solid #e6efed;border-radius:12px;padding:clamp(12px,1.5vw,18px);box-shadow:var(--shadow);border-top:4px solid var(--teal)}
  .kn.risk{border-top-color:var(--bad)}
  .kn .knh{font-size:.72rem;font-weight:800;color:var(--teal);letter-spacing:.06em}
  .kn .el{font-size:clamp(1rem,1.5vw,1.25rem);font-weight:800;margin:4px 0}
  .kn .ex{font-size:clamp(.78rem,1.1vw,.92rem);color:var(--muted);line-height:1.3}
  .kn .risktag{display:inline-block;margin-top:8px;font-size:.66rem;font-weight:800;color:var(--bad);background:#fdeaea;border-radius:999px;padding:2px 8px}

  /* ---------- Roadmap (slide 13) ---------- */
  .road{display:flex;flex-direction:column;gap:6px}
  .phase{display:flex;gap:14px;align-items:flex-start;cursor:pointer;background:#fff;border:1px solid #e6efed;
    border-radius:12px;padding:clamp(8px,1.1vw,13px) clamp(12px,1.6vw,20px);transition:.25s;box-shadow:0 2px 8px rgba(21,83,73,.05)}
  .phase:hover{box-shadow:var(--shadow);transform:translateX(3px)}
  .phase .pn{flex:0 0 auto;width:clamp(38px,3.4vw,46px);height:clamp(38px,3.4vw,46px);border-radius:12px;background:var(--teal);
    color:#fff;display:grid;place-items:center;font-weight:800;font-size:clamp(.85rem,1.3vw,1.1rem);line-height:1.05;text-align:center}
  .phase .pn small{font-size:.5em;display:block;font-weight:700;opacity:.85}
  .phase .body{flex:1;min-width:0}
  .phase .ttl{font-weight:800;font-size:clamp(.92rem,1.3vw,1.12rem);display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .phase .kpchip{font-size:.66rem;font-weight:800;background:var(--teal-soft);color:var(--teal-dark);border-radius:999px;padding:2px 9px}
  .phase .det{max-height:0;overflow:hidden;transition:max-height .4s ease;color:var(--muted);font-size:clamp(.82rem,1.15vw,.98rem);line-height:1.4}
  .phase.open .det{max-height:120px;margin-top:6px}
  .phase.open .pn{background:var(--teal-dark)}
  .phase.spoed .pn{background:var(--magenta)}

  .hintclick{font-size:.78rem;color:#9bada9;font-style:italic;margin-top:10px}

  /* ---------- Notes panel ---------- */
  #notes{position:fixed;left:0;right:0;bottom:0;z-index:50;background:#11211e;color:#e8f4f2;
    max-height:46vh;overflow:auto;padding:22px clamp(28px,6vw,90px) 28px;
    box-shadow:0 -12px 30px rgba(0,0,0,.3);transform:translateY(101%);transition:transform .35s ease}
  #notes.open{transform:none}
  #notes h4{margin:0 0 8px;color:var(--teal);font-size:.78rem;letter-spacing:.14em;text-transform:uppercase}
  #notes .ntext{font-size:clamp(.95rem,1.5vw,1.18rem);line-height:1.55;max-width:80ch}
  #notes .ncount{position:absolute;top:14px;right:24px;font-size:.78rem;color:#7fa39c}

  /* ---------- Help overlay ---------- */
  #help{position:fixed;inset:0;z-index:60;background:rgba(13,36,32,.86);display:none;
    align-items:center;justify-content:center;padding:24px}
  #help.open{display:flex}
  .helpcard{background:#fff;border-radius:18px;padding:32px 40px;max-width:520px;box-shadow:var(--shadow)}
  .helpcard h3{font-size:1.4rem;margin-bottom:18px;color:var(--teal-dark)}
  .helpcard table{width:100%;border-collapse:collapse}
  .helpcard td{padding:8px 4px;border-bottom:1px solid #eef2f1;font-size:.98rem}
  .helpcard td:first-child{width:130px}
  kbd{background:#eef2f1;border:1px solid #d6e0de;border-bottom-width:2px;border-radius:6px;padding:2px 9px;
    font-family:inherit;font-size:.85em;font-weight:700;color:var(--teal-dark)}

  /* ---------- Nav arrows ---------- */
  .nav{position:fixed;bottom:8px;left:50%;transform:translateX(-50%);z-index:27;display:flex;gap:8px}
  .nav button{width:38px;height:38px;border-radius:10px;border:1px solid var(--teal-line);background:#fff;
    color:var(--teal-dark);font-size:1.1rem;cursor:pointer;display:grid;place-items:center;box-shadow:0 2px 8px rgba(21,83,73,.08);transition:.2s}
  .nav button:hover{background:var(--teal-soft)}
  body.cover .nav{opacity:0;pointer-events:none}

  .notes-hint{position:fixed;bottom:60px;right:24px;z-index:24;font-size:.74rem;color:#9bada9;background:#fff;
    border:1px solid #e6efed;border-radius:8px;padding:5px 10px;box-shadow:0 2px 8px rgba(21,83,73,.06)}
  body.cover .notes-hint{opacity:0}

  @media (max-width:820px){
    .cols,.flow,.kluwen,.syn{flex-direction:column}
    .kpgrid,.grid2,.grid3,.knoster{grid-template-columns:1fr 1fr}
    .knoster{grid-template-columns:1fr 1fr}
  }
</style>
</head>
<body class="cover">

<div id="deck">

  <!-- ===== Slide 1 — TITEL ===== -->
  <section class="slide cover-slide active">
    <div class="cover-logos">
      <div class="chip"><img src="data:image/png;base64," alt="Contecto"></div>
      <div class="chip"><img src="data:image/png;base64," alt="HAN University of Applied Sciences"></div>
    </div>
    <span class="pill">Verdediging adviesrapport</span>
    <h1 style="margin-top:18px">Productieplanning&nbsp;2.0</h1>
    <p class="lead">Herontwerp van de productieplanning in Ridder iQ bij Contecto BV</p>
    <div class="cover-meta">
      <div class="it"><span>Student</span><b>Senn Lauwers · 1656013</b></div>
      <div class="it"><span>Opleiding</span><b>Technische Bedrijfskunde — HAN</b></div>
      <div class="it"><span>Datum</span><b>22 juni 2026</b></div>
    </div>
    <div class="cover-hint">Navigeer met <kbd>→</kbd><kbd>spatie</kbd> · vorige <kbd>←</kbd> · spreeknotities <kbd>N</kbd> · hulp <kbd>?</kbd></div>
    <aside class="notes" hidden>Goedemiddag. Mijn naam is Senn Lauwers en ik verdedig vandaag mijn adviesrapport Productieplanning 2.0, uitgevoerd bij Contecto in Beugen. In ongeveer vijftien minuten neem ik u mee langs het probleem, de diagnose, het ontwerp en het veranderadvies. De evaluatiefase valt bewust buiten de scope van dit onderzoek; ik licht straks toe waarom.</aside>
  </section>

  <!-- ===== Slide 2 — AANLEIDING (P) ===== -->
  <section class="slide" data-phase="P">
    <span class="eyebrow">Probleemidentificatie</span>
    <h2>Een bedrijf dat sneller groeide dan zijn planning</h2>
    <div class="accentbar"></div>
    <div class="cols">
      <div class="col">
        <ul class="clean">
          <li class="fragment">Contecto is een <b>elektronicaproducent</b> in Beugen die printplaten (PCBA's) assembleert op twee afdelingen: <b>SMT</b> en <b>THT</b>, gepland in het ERP-systeem <b>Ridder iQ</b>.</li>
          <li class="fragment">Sinds 2019 is de <b>orderstroom verviervoudigd</b>, maar de planningsmethodiek is niet meegegroeid.</li>
